{
  "name": "vidriera-chabas",
  "private": true,
  "version": "1.0.0",
  "description": "Vidriera Chabás: avisos de casas, vehículos y maquinaria agro de Chabás. React + TypeScript + Node + SQLite.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch & node --watch server/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node server/index.ts",
    "ejemplos": "node server/seed.ts",
    "clave": "node scripts/clave.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.0"
  }
}
