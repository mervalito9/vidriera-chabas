# Copiá este archivo como .env (en el servidor) y completalo. Nunca lo subas a GitHub.

# Tu dominio, sin https:// (ej: vidrierachabas.com.ar). Caddy saca el certificado HTTPS solo.
DOMINIO=

# La dirección completa del sitio (para que WhatsApp muestre la foto al compartir un aviso)
SITE_URL=https://

# Contraseña del panel, hasheada. Generala con: npm run clave
ADMIN_PASSWORD_HASH=

# 1 = no aparecer en Google todavía. Ponelo en 0 el día que lances.
NOINDEX=1
