# Copiá este archivo como .env (en el servidor) y completalo. Nunca lo subas a GitHub.

# Tu dominio, sin https:// (ej: vidrierachabas.com.ar). Caddy saca el certificado HTTPS solo.
DOMINIO=

# La dirección completa del sitio (para que WhatsApp muestre la foto al compartir un aviso)
SITE_URL=https://

# Contraseña del panel, hasheada. Generala con: npm run clave
ADMIN_PASSWORD_HASH=

# 1 = no aparecer en Google todavía. Ponelo en 0 el día que lances.
NOINDEX=1

# --- Asistente de avisos por Telegram (opcional; sin estas variables no se activa) ---
# Token del bot: se pide a @BotFather en Telegram (/newbot)
TELEGRAM_BOT_TOKEN=
# Tu ID numérico de Telegram (se obtiene hablándole a @userinfobot). Varios, separados por coma.
TELEGRAM_USER_ID=
# Clave de la API de Claude (console.anthropic.com). Ponele un tope de gasto mensual.
ANTHROPIC_API_KEY=
# Opcional: modelo (por defecto claude-sonnet-5-5) y tu contacto para los avisos propios
ANTHROPIC_MODEL=
BOT_NOMBRE_PROPIO=Felipe
BOT_TELEFONO_PROPIO=

# Opcional: dólar fijo para comparar precios en USD y en $ (sin esto, se usa el oficial del día)
# DOLAR_REFERENCIA=1550
